# Normalize all text files to LF in the repo and in the working copy
* text=auto eol=lf

# Windows-only scripts need CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never touch line endings or diff as text
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.zip  binary
*.pdf  binary
*.woff binary
*.woff2 binary
